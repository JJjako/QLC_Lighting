  <!-- ─── EFX Moving Head patterns ─────────────────────────────────────── -->
  <Function Type="EFX" ID="80" Name="EFX Circle">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <Algorithm>Circle</Algorithm>
   <Width>100</Width>
   <Height>100</Height>
   <Rotation>0</Rotation>
   <StartOffset>0</StartOffset>
   <IsRelative>0</IsRelative>
   <Axis ID="0" Invert="0">
    <Channel>0</Channel>  <!-- Pan -->
   </Axis>
   <Axis ID="1" Invert="0">
    <Channel>2</Channel>  <!-- Tilt -->
   </Axis>
   <Fixture Direction="Forward" StartOffset="0">0</Fixture>
   <Fixture Direction="Forward" StartOffset="90">1</Fixture>
   <Fixture Direction="Forward" StartOffset="180">2</Fixture>
   <Fixture Direction="Forward" StartOffset="270">3</Fixture>
  </Function>

  <Function Type="EFX" ID="81" Name="EFX Figure-8">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <Algorithm>Lissajous</Algorithm>
   <Width>100</Width>
   <Height>100</Height>
   <Rotation>0</Rotation>
   <StartOffset>0</StartOffset>
   <IsRelative>0</IsRelative>
   <Axis ID="0" Invert="0"><Channel>0</Channel></Axis>
   <Axis ID="1" Invert="0"><Channel>2</Channel></Axis>
   <Fixture Direction="Forward" StartOffset="0">0</Fixture>
   <Fixture Direction="Forward" StartOffset="90">1</Fixture>
   <Fixture Direction="Forward" StartOffset="180">2</Fixture>
   <Fixture Direction="Forward" StartOffset="270">3</Fixture>
  </Function>

  <Function Type="EFX" ID="82" Name="EFX Random">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <Algorithm>Diamond</Algorithm>
   <Width>80</Width>
   <Height>80</Height>
   <Rotation>0</Rotation>
   <StartOffset>0</StartOffset>
   <IsRelative>0</IsRelative>
   <Axis ID="0" Invert="0"><Channel>0</Channel></Axis>
   <Axis ID="1" Invert="0"><Channel>2</Channel></Axis>
   <Fixture Direction="Forward" StartOffset="0">0</Fixture>
   <Fixture Direction="Forward" StartOffset="90">1</Fixture>
   <Fixture Direction="Forward" StartOffset="180">2</Fixture>
   <Fixture Direction="Forward" StartOffset="270">3</Fixture>
  </Function>

  <Function Type="EFX" ID="83" Name="EFX Fan">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <Algorithm>Line</Algorithm>
   <Width>100</Width>
   <Height>40</Height>
   <Rotation>0</Rotation>
   <StartOffset>0</StartOffset>
   <IsRelative>0</IsRelative>
   <Axis ID="0" Invert="0"><Channel>0</Channel></Axis>
   <Axis ID="1" Invert="0"><Channel>2</Channel></Axis>
   <Fixture Direction="Forward" StartOffset="0">0</Fixture>
   <Fixture Direction="Forward" StartOffset="64">1</Fixture>
   <Fixture Direction="Forward" StartOffset="128">2</Fixture>
   <Fixture Direction="Forward" StartOffset="192">3</Fixture>
  </Function>

