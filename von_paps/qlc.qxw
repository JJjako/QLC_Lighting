 <!-- ═══════════════════════════════════════════════════════════════════════
      FIXTURES
      ═══════════════════════════════════════════════════════════════════════ -->
 <Engine>
  <InputOutputMap>
   <Universe Name="Universe 1" ID="0">
    <Output Plugin="DMX USB" UID="your-dmx-uid" Line="0"/>
    <Input Plugin="OSC" UID="OSC" Line="0"/>
   </Universe>
  </InputOutputMap>

  <!-- Moving Head 1 – monitor, DMX 1–14 -->
