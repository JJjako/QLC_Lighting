  <!-- ═══════════════════════════════════════════════════════════════════════
       FUNCTIONS
       ID map:
         20-22  = RGBW individual full-on scenes
         23     = All RGBW full-on
         30-37  = RGBW colour scenes (Red/Green/Blue/White/Purple/Yellow/Cyan/Off)
         40-44  = Moving head colour scenes
         50-56  = Flash scenes (same content as colour scenes, used for flash page)
         60-61  = Strobe chasers
         70-74  = MH position presets
         80-85  = MH EFX functions
         99     = Blackout
         100    = Full ON
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ─── RGBW individual masters ──────────────────────────────────────── -->
  <Function Type="Scene" ID="20" Name="RGBW moni full-on">
   <FixtureVal ID="4">255,255,255,255</FixtureVal>
  </Function>

  <Function Type="Scene" ID="21" Name="RGBW main full-on">
   <FixtureVal ID="5">255,255,255,255</FixtureVal>
  </Function>

  <Function Type="Scene" ID="22" Name="RGBW komple full-on">
   <FixtureVal ID="6">255,255,255,255</FixtureVal>
  </Function>

