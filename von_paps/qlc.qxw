  <!-- ═══════════════════════════════════════════════════════════════════════
       OSC INPUT PLUGIN CONFIG
       Port 7700 — all /qlc/function/<id> messages start/stop functions.
       QLC+ handles this natively when OSC input is enabled.
       ═══════════════════════════════════════════════════════════════════════ -->
  <InputOutputMap>
   <Universe Name="OSC" ID="1">
    <Input Plugin="OSC" UID="OSC" Line="0" FeedbackEnabled="0"/>
   </Universe>
  </InputOutputMap>

 </Engine>

 <!-- ═══════════════════════════════════════════════════════════════════════
      VIRTUAL CONSOLE  (minimal — actual control is via Launchpad bridge)
      ═══════════════════════════════════════════════════════════════════════ -->
 <VirtualConsole>
  <Frame>
   <Appearance>
    <FrameStyle>None</FrameStyle>
    <ForegroundColor>Default</ForegroundColor>
    <BackgroundColor>Default</BackgroundColor>
    <BackgroundImage>None</BackgroundImage>
    <Font>Default</Font>
   </Appearance>

   <!-- Simple blackout button on VC for safety -->
   <Button Caption="BLACKOUT" ID="1" Icon="">
    <WindowState Visible="True" X="10" Y="10" Width="120" Height="60"/>
    <Appearance>
     <FrameStyle>Sunken</FrameStyle>
     <ForegroundColor>#ff0000</ForegroundColor>
     <BackgroundColor>#300000</BackgroundColor>
