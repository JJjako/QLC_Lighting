  <!-- ─── Strobe chasers ────────────────────────────────────────────────── -->
  <Function Type="Chaser" ID="60" Name="Strobe Fast">
   <Speed FadeIn="0" FadeOut="0" Duration="80"/>
   <Direction>Forward</Direction>
   <RunOrder>Loop</RunOrder>
   <Step Number="0" FadeIn="0" FadeOut="0" Duration="80">53</Step>
   <Step Number="1" FadeIn="0" FadeOut="0" Duration="80">37</Step>
  </Function>

  <Function Type="Chaser" ID="61" Name="Strobe Slow">
